#!/bin/sh
# Auto-run `npm install` after a branch checkout when the dependency manifest changed.
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for branch checkout (0 for file checkout).
# Install via: node scripts/install-git-hooks.js

[ "$3" = "1" ] || exit 0
[ "$1" = "$2" ] && exit 0

if git diff --name-only "$1" "$2" 2>/dev/null | grep -qE '^package(-lock)?\.json$'; then
  echo "[sigma git-hook] package.json / package-lock.json changed — running npm install..."
  npm install --no-fund --no-audit
fi
