{
  "name": "sigma-ecosystem",
  "version": "0.10.0",
  "description": "Sigma — Lightweight project governance CLI",
  "license": "MIT",
  "bin": {
    "sigma": "./bin/sigma.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin/",
    "dist/",
    "setup/",
    "Sigma/templates/",
    "Sigma/rules/",
    "Sigma/role-memory/",
    "Sigma/SIGMA_CONSTITUTION.md",
